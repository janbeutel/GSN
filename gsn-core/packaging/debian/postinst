#!/bin/sh
set -e

SERVICE_NAME="gsn-core.service"
SERVICE_USER="gsn"
INSTALL_DIR="/usr/share/gsn-core"
VIRTUAL_SENSORS_DIR="${INSTALL_DIR}/conf/virtual-sensors"

# Ensure the service account exists before systemd tries to start the unit.
if ! getent group "${SERVICE_USER}" >/dev/null 2>&1; then
  groupadd --system "${SERVICE_USER}"
fi

if ! getent passwd "${SERVICE_USER}" >/dev/null 2>&1; then
  useradd --system --gid "${SERVICE_USER}" --home "${INSTALL_DIR}" --shell /usr/sbin/nologin "${SERVICE_USER}"
fi

mkdir -p "${VIRTUAL_SENSORS_DIR}"

if [ -d "${INSTALL_DIR}" ]; then
  chown -R "${SERVICE_USER}:${SERVICE_USER}" "${INSTALL_DIR}"
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable "${SERVICE_NAME}" || true
  systemctl restart "${SERVICE_NAME}" || systemctl start "${SERVICE_NAME}" || true
fi

exit 0
